{
    "name": "nanobar",
    "version": "1.0.0",
    "private": true,
    "description": "SCSS build for the NanoBar WordPress plugin.",
    "scripts": {
        "build": "npm run build:frontend && npm run build:admin",
        "build:frontend": "sass --style=compressed --no-source-map --no-charset assets/scss/frontend.scss assets/css/frontend.css",
        "build:admin": "sass --style=compressed --no-source-map --no-charset assets/scss/admin.scss assets/css/admin.css",
        "watch": "sass --watch --no-source-map --no-charset assets/scss/frontend.scss:assets/css/frontend.css assets/scss/admin.scss:assets/css/admin.css",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint:css": "stylelint \"assets/scss/**/*.scss\"",
        "lint:js": "eslint \"assets/js/**/*.js\"",
        "test:js": "node --test tests/js/helpers.test.js"
    },
    "devDependencies": {
        "@wordpress/eslint-plugin": "^25.7.0",
        "@wordpress/prettier-config": "^4.51.0",
        "@wordpress/stylelint-config": "^24.0.0",
        "eslint": "^9.39.5",
        "prettier": "^3.9.6",
        "sass": "^1.101.6",
        "stylelint": "^16.26.1"
    }
}
